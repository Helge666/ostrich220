+/* Diagnostics for the Ostrich panel freeze, read by its UI (OstrichUI.cpp):
+   0 WM_PAINT received, 1 exposes drawn, 2 expose enters failed, 3 obscure calls,
+   4 obscures refused (EXPOSING), 5 stale exposes healed, 6 puglUpdate calls,
+   7 puglUpdate refused, 8 InvalidateRect failed, 9 world state at the last
+   obscure, 10 view stage at the last WM_PAINT, 11 window visible at the last
+   obscure, 12 WM_PAINT with an empty update rect. */
+unsigned long puglWinDebug[16];
+
+/* The world stuck in EXPOSING -- a draw that never returned (an exception the
+   window procedure swallowed, a fault in the driver) -- refuses every redisplay
+   for good: the view freezes while its plugin runs on.  No real expose lasts a
+   second, so after that the state is taken to be stale and reset. */
+static void
+puglHealStaleExpose(PuglView* view)
+{
+  if (view->world->state == PUGL_WORLD_EXPOSING &&
+      puglGetTime(view->world) - view->world->exposeStart > 1.0) {
+    view->world->state = PUGL_WORLD_IDLE;
+    ++puglWinDebug[5];
+  }
+  ++puglWinDebug[3];
+  puglWinDebug[9]  = (unsigned long)view->world->state;
+  puglWinDebug[11] = IsWindowVisible(view->impl->hwnd) ? 1UL : 0UL;
+  if (view->world->state == PUGL_WORLD_EXPOSING) {
+    ++puglWinDebug[4];
+  }
+}
+
 PuglStatus
 puglObscureView(PuglView* view)
 {
+  puglHealStaleExpose(view);
   return view->world->state == PUGL_WORLD_EXPOSING
            ? PUGL_BAD_CALL
            : puglWinStatus(InvalidateRect(view->impl->hwnd, NULL, false));
@@ -1212,6 +1247,7 @@ puglObscureRegion(PuglView* const view,
                   const unsigned  width,
                   const unsigned  height)
 {
+  puglHealStaleExpose(view);
   if (view->world->state == PUGL_WORLD_EXPOSING) {
     return PUGL_BAD_CALL;
   }
