diff --git a/distrho/src/DistrhoUIVST3.cpp b/distrho/src/DistrhoUIVST3.cpp
index 744551c4..3394a40f 100644
--- a/distrho/src/DistrhoUIVST3.cpp
+++ b/distrho/src/DistrhoUIVST3.cpp
@@ -563,6 +563,17 @@ public:
         if (fReadyForPluginData)
         {
             fReadyForPluginData = false;
+            fIdlesWithoutReady = 0;
+            requestMorePluginData();
+        }
+        // The controller answers each "idle" with one "ready", and only then is the next
+        // "idle" sent: a single lost answer stopped every parameter and state update to
+        // this view for good, a panel frozen while the plugin played on (seen in Cubase).
+        // Ask again after about a second without one.  A late answer then arrives twice,
+        // which costs one assertion message in "ready" and nothing else.
+        else if (fConnection != nullptr && ++fIdlesWithoutReady >= kIdlesBeforeRetry)
+        {
+            fIdlesWithoutReady = 0;
             requestMorePluginData();
         }
 
@@ -597,6 +608,8 @@ private:
     // Temporary data
     float fScaleFactor;
     bool fReadyForPluginData;
+    uint32_t fIdlesWithoutReady = 0;
+    static constexpr uint32_t kIdlesBeforeRetry = 60;
     bool fIsResizingFromPlugin;
     bool fIsResizingFromHost;
     bool fNeedsResizeFromPlugin;
