+// Every size call between host and view, to %PROGRAMDATA%/Ostrich/ostrich-ui.log (Ostrich,
+// patches/0010): Cubase at 125 % shrank the view step by step on opening.
+static void sizeTrace(const char* const what, const int32_t w, const int32_t h, const int32_t w2 = -1, const int32_t h2 = -1)
+{
+    const char* const base = std::getenv("PROGRAMDATA");
+    if (base == nullptr)
+        return;
+    char path[512];
+    std::snprintf(path, sizeof(path), "%s/Ostrich/ostrich-ui.log", base);
+    if (FILE* const f = std::fopen(path, "a"))
+    {
+        const std::time_t now = std::time(nullptr);
+        char stamp[32];
+        std::strftime(stamp, sizeof(stamp), "%Y-%m-%d %H:%M:%S", std::localtime(&now));
+        if (w2 >= 0)
+            std::fprintf(f, "%s vst3 %s %dx%d -> %dx%d\n", stamp, what, w, h, w2, h2);
+        else
+            std::fprintf(f, "%s vst3 %s %dx%d\n", stamp, what, w, h);
+        std::fclose(f);
+    }
+}
