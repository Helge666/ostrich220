+    // The key/value pair of a state message, without acting on it.
+    v3_result readStateAttributes(v3_attribute_list** const attrs, String& key, String& value)
+    {
+        int64_t keyLength = -1;
+        int64_t valueLength = -1;
+        v3_result res;
+
+        res = v3_cpp_obj(attrs)->get_int(attrs, "key:length", &keyLength);
+        DISTRHO_SAFE_ASSERT_INT_RETURN(res == V3_OK, res, res);
+        DISTRHO_SAFE_ASSERT_INT_RETURN(keyLength >= 0, keyLength, V3_INTERNAL_ERR);
+
+        res = v3_cpp_obj(attrs)->get_int(attrs, "value:length", &valueLength);
+        DISTRHO_SAFE_ASSERT_INT_RETURN(res == V3_OK, res, res);
+        DISTRHO_SAFE_ASSERT_INT_RETURN(valueLength >= 0, valueLength, V3_INTERNAL_ERR);
+
+        std::vector<int16_t> key16(static_cast<size_t>(keyLength + 1), 0);
+        std::vector<int16_t> value16(static_cast<size_t>(valueLength + 1), 0);
+        std::vector<char> key8(static_cast<size_t>(keyLength) * 3 + 1, '\0');
+        std::vector<char> value8(static_cast<size_t>(valueLength) * 3 + 1, '\0');
+
+        res = v3_cpp_obj(attrs)->get_string(attrs, "key", key16.data(), sizeof(int16_t)*(keyLength+1));
+        DISTRHO_SAFE_ASSERT_INT2_RETURN(res == V3_OK, res, keyLength, res);
+
+        if (valueLength != 0)
+        {
+            res = v3_cpp_obj(attrs)->get_string(attrs, "value", value16.data(), sizeof(int16_t)*(valueLength+1));
+            DISTRHO_SAFE_ASSERT_INT2_RETURN(res == V3_OK, res, valueLength, res);
+        }
+
+        // back to UTF-8 (in full once patch 0014 is in); the lengths are the sender's UTF-8
+        // byte counts, and UTF-8 may be longer than the UTF-16 it came from
+        key16.back() = 0;
+        value16.back() = 0;
+        strncpy_utf8(key8.data(), key16.data(), key8.size());
+        strncpy_utf8(value8.data(), value16.data(), value8.size());
+
+        key = key8.data();
+        value = value8.data();
+        return V3_OK;
+    }
    #endif // DISTRHO_PLUGIN_WANT_STATE
 
+   #if DISTRHO_PLUGIN_WANT_STATE
+    // Main thread only.  Empties what updateState() queued from run(): straight to the view
+    // when this instance has one, otherwise across to the controller as "state-push".
+    void drainStateQueue()
+    {
+        for (uint32_t read = fStateQueueRead.load(std::memory_order_relaxed);
+             read != fStateQueueWrite.load(std::memory_order_acquire);
+             read = (read + 1) % kStateQueueSize)
+        {
+            const StateMessage& msg(fStateQueue[read]);
+
+           #if DPF_VST3_USES_SEPARATE_CONTROLLER
+            if (fConnectionFromCompToCtrl != nullptr)
+            {
+                if (v3_message** const message = createMessage("state-push"))
+                {
+                    if (v3_attribute_list** const attrlist = v3_cpp_obj(message)->get_attributes(message))
+                    {
+                        v3_cpp_obj(attrlist)->set_int(attrlist, "__dpf_msg_target__", 1);
+                        v3_cpp_obj(attrlist)->set_int(attrlist, "key:length", std::strlen(msg.key));
+                        v3_cpp_obj(attrlist)->set_int(attrlist, "value:length", std::strlen(msg.value));
+                        v3_cpp_obj(attrlist)->set_string(attrlist, "key", ScopedUTF16String(msg.key));
+                        v3_cpp_obj(attrlist)->set_string(attrlist, "value", ScopedUTF16String(msg.value));
+                        v3_cpp_obj(fConnectionFromCompToCtrl)->notify(fConnectionFromCompToCtrl, message);
+                    }
+                    v3_cpp_obj_unref(message);
+                }
+            }
+           #else
+            if (fConnectionFromCtrlToView != nullptr && fConnectedToUI)
+                sendStateSetToUI(msg.key, msg.value);
+           #endif
+
+            fStateQueueRead.store((read + 1) % kStateQueueSize, std::memory_order_release);
+        }
+    }
+   #endif
