+// What the host does with the audio buses, to %PROGRAMDATA%/Ostrich/ostrich-dsp.log
+// (Ostrich, patches/0011).
+static void busTrace(const char* const format, ...)
+{
+    const char* const base = std::getenv("PROGRAMDATA");
+    if (base == nullptr)
+        return;
+    char path[512];
+    std::snprintf(path, sizeof(path), "%s/Ostrich/ostrich-dsp.log", base);
+    if (FILE* const f = std::fopen(path, "a"))
+    {
+        const std::time_t now = std::time(nullptr);
+        char stamp[32];
+        std::strftime(stamp, sizeof(stamp), "%Y-%m-%d %H:%M:%S", std::localtime(&now));
+        std::fprintf(f, "%s vst3 ", stamp);
+        va_list args;
+        va_start(args, format);
+        std::vfprintf(f, format, args);
+        va_end(args);
+        std::fputc('\n', f);
+        std::fclose(f);
+    }
+}
